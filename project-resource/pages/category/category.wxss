.category-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 导航栏 */
.custom-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
  flex-shrink: 0;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.page-content {
  flex: 1;
  display: flex;
  flex-direction: row;
  overflow: hidden;
}

.left-panel {
  width: 200rpx;
  background-color: #fafafa;
  border-right: 1rpx solid #eee;
  height: 100%;
}

.group-item {
  position: relative;
  padding: 32rpx 24rpx;
  text-align: center;
  transition: all 0.2s;
}

.group-item.active {
  background-color: #ffffff;
}

.group-name {
  font-size: 28rpx;
  color: #666;
}

.group-item.active .group-name {
  color: #f59e0b;
  font-weight: bold;
}

.right-panel {
  flex: 1;
  height: 100%;
  padding: 24rpx;
}

.sub-category-section {
  padding: 0 0 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-dot {
  width: 40rpx;
  height: 2rpx;
  background-color: #e8e8e8;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.sub-category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.sub-category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.2s;
}

.sub-category-item.active .sub-category-name {
  color: #f59e0b;
  font-weight: bold;
}

.sub-category-item.active .sub-category-icon {
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.sub-category-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sub-emoji {
  font-size: 44rpx;
}

.sub-text-icon {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.sub-category-name {
  font-size: 24rpx;
  color: #555;
}

.divider {
  height: 16rpx;
  background-color: #f8f8f8;
  margin: 24rpx -24rpx 20rpx;
}

.resources-section {
  padding-top: 10rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.more-text {
  font-size: 24rpx;
  color: #999;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.grid-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #eee;
}

.grid-cover {
  width: 100%;
  height: 160rpx;
  background-color: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cover-placeholder {
  font-size: 48rpx;
}

.vip-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.grid-info {
  padding: 16rpx 16rpx 20rpx;
}

.grid-title {
  font-size: 26rpx;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 10rpx;
}

.grid-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.grid-price {
  font-size: 30rpx;
  font-weight: bold;
}

.grid-download {
  font-size: 24rpx;
}

.load-more {
  text-align: center;
  padding: 40rpx 0;
}
