page {
  background-color: #f5f5f5;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* ========== Common ========== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

/* ========== Card ========== */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e8e8e8;
}

/* ========== Text ========== */
.text-primary {
  color: #f59e0b;
}

.text-muted {
  color: #999999;
}

.text-dark {
  color: #333333;
}

.text-sm {
  font-size: 24rpx;
}

.text-lg {
  font-size: 36rpx;
}

.text-xl {
  font-size: 44rpx;
}

.text-center {
  text-align: center;
}

/* ========== Button ========== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #ffffff;
  font-weight: bold;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid #f59e0b;
  color: #f59e0b;
}

.btn-block {
  display: flex;
  width: 100%;
}

.btn-sm {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}

.btn-lg {
  padding: 20rpx 60rpx;
  font-size: 32rpx;
}

/* ========== Tag ========== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-primary {
  background-color: rgba(245, 158, 11, 0.12);
  color: #f59e0b;
}

.tag-vip {
  background: linear-gradient(135deg, #f59e0b, #eab308);
  color: #ffffff;
  font-weight: bold;
}

/* ========== Grid ========== */
.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

/* ========== Divider ========== */
.divider {
  height: 1rpx;
  background-color: #e8e8e8;
  margin: 24rpx 0;
}

/* ========== List Item ========== */
.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.list-item:last-child {
  border-bottom: none;
}

/* ========== Empty ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .empty-text {
  color: #999999;
  font-size: 28rpx;
}
