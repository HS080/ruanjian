.index-page {
  padding-bottom: 40rpx;
}

.custom-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.top-banner {
  position: relative;
  padding: 44rpx 32rpx 36rpx;
  overflow: hidden;
}

.banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 40%, #f59e0b 100%);
  border-radius: 0 0 50rpx 50rpx;
}

.banner-content {
  position: relative;
  z-index: 1;
}

.banner-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.banner-title {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.banner-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.banner-decor {
  position: absolute;
  right: -40rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, transparent 70%);
}

.search-bar-wrap {
  padding: 20rpx 20rpx;
}

.search-bar {
  background-color: #fff;
  border-radius: 44rpx;
  padding: 20rpx 30rpx;
  border: 1rpx solid #eee;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.search-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-width: 0;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  background-color: #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  flex-shrink: 0;
}

.search-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  background-color: #f59e0b;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  min-width: 80rpx;
}

.search-action.has-value {
  background-color: #f5f5f5;
  color: #999;
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 24rpx;
}

.search-btn {
  padding: 12rpx 24rpx;
  background-color: #f59e0b;
  color: #fff;
  font-size: 24rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.search-placeholder {
  color: #bbb;
}

.poster-section {
  padding: 0 20rpx 24rpx;
}

.poster-image {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.notice-bar {
  margin: 0 20rpx 20rpx;
  background: linear-gradient(135deg, #fff9f0 0%, #fff5e6 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.15);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
}

.notice-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
  overflow: hidden;
  position: relative;
  height: 36rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #d97706;
  white-space: nowrap;
  display: inline-block;
  will-change: transform;
}

.category-nav-section {
  margin-top: 28rpx;
}

.category-nav {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 20rpx;
}

.cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background-color: #f8f8f8;
  transition: all 0.2s;
}

.cat-item.active {
  background-color: #fff5e6;
  border: 1rpx solid #f59e0b;
}

.cat-icon {
  font-size: 32rpx;
}

.cat-name {
  font-size: 24rpx;
  color: #555;
}

.cat-item.active .cat-name {
  color: #f59e0b;
  font-weight: bold;
}

.quick-grid-section {
  padding: 30rpx 20rpx 10rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 16rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.quick-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-emoji {
  font-size: 40rpx;
}

.quick-name {
  font-size: 24rpx;
  color: #444;
}

.ad-banner-section {
  padding: 18rpx 20rpx 0;
}

.ad-banner {
  background: linear-gradient(135deg, #fff5e6 0%, #fff0e0 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.2);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ad-left {
  flex: 1;
}

.ad-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  border-radius: 12rpx;
  display: inline-block;
  margin-bottom: 10rpx;
}

.ad-title {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  display: block;
  margin-bottom: 4rpx;
}

.ad-desc {
  font-size: 22rpx;
  color: #888;
}

.ad-btn {
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 30rpx;
}

.stats-bar {
  margin: 24rpx 20rpx 0;
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding: 30rpx 24rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #f59e0b;
}

.stat-label {
  font-size: 24rpx;
  color: #888;
}

.stat-line {
  width: 1rpx;
  height: 54rpx;
  background-color: #eee;
}

.tabs-section {
  padding: 24rpx 20rpx 16rpx;
}

.tabs {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  padding: 8rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #555;
  transition: all 0.2s;
}

.tab-item.active {
  background-color: #fff;
  color: #f59e0b;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.resource-section {
  padding: 0 20rpx;
}

.resource-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.resource-item {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
}

.res-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  background-color: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.cover-emoji {
  font-size: 56rpx;
}

.hot-tag {
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  background-color: #ef4444;
  color: #fff;
  border-radius: 10rpx 0 14rpx 0;
}

.res-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.res-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.res-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.vip-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  font-weight: bold;
  flex-shrink: 0;
}

.res-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.res-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.res-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.res-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: rgba(245, 158, 11, 0.08);
  color: #f59e0b;
}

.res-time {
  font-size: 22rpx;
  color: #aaa;
}

.res-price {
  font-size: 34rpx;
  font-weight: bold;
}

.load-more {
  text-align: center;
  padding: 36rpx 0;
}

.footer-space {
  height: 80rpx;
}

.welcome-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.welcome-modal {
  width: 640rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.welcome-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  text-align: center;
  margin-bottom: 50rpx;
}

.welcome-btn {
  width: 100%;
  padding: 24rpx;
  background-color: #f59e0b;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  text-align: center;
  border-radius: 16rpx;
}
