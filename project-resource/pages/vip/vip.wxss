.vip-page {
  padding: 0 16rpx;
  padding-bottom: 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

/* 导航栏 */
.custom-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
  margin: 0 -16rpx;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.page-content {
  padding-top: 20rpx;
}

/* ========== Banner ========== */
.vip-banner {
  position: relative;
  background: linear-gradient(135deg, #fff8f0 0%, #fffbeb 50%, #fff8f0 100%);
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.2);
  overflow: hidden;
}

.banner-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.banner-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.banner-title {
  font-size: 34rpx;
  color: #f59e0b;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-align: center;
  word-wrap: break-word;
}

.banner-desc {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  word-wrap: break-word;
}

.banner-bg {
  position: absolute;
  right: -50rpx;
  top: -50rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245, 158, 11, 0.1), transparent 70%);
}

/* ========== VIP Cards ========== */
.vip-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.vip-card {
  position: relative;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #e8e8e8;
  border-left: 4rpx solid var(--card-color);
  box-sizing: border-box;
  overflow: hidden;
}

.vip-card.recommend {
  border-color: rgba(245, 158, 11, 0.3);
  border-left-color: #f59e0b;
  box-shadow: 0 4rpx 20rpx rgba(245, 158, 11, 0.12);
}

.recommend-badge {
  position: absolute;
  top: 0;
  right: 20rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 6rpx 18rpx;
  border-radius: 0 0 12rpx 12rpx;
}

.card-header {
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.card-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
  display: block;
  word-wrap: break-word;
}

.card-duration {
  font-size: 22rpx;
  color: #888888;
}

.card-desc {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.6;
  word-wrap: break-word;
}

.card-features {
  margin-bottom: 20rpx;
}

.feature-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.feature-dot {
  color: var(--card-color);
  font-weight: bold;
  font-size: 24rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.feature-text {
  font-size: 24rpx;
  color: #777777;
  line-height: 1.6;
  word-wrap: break-word;
  flex: 1;
}

.card-btn {
  border-radius: 36rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
}

/* ========== Rules ========== */
.vip-rules {
  margin-top: 28rpx;
  border-left: 4rpx solid #f59e0b;
  padding: 20rpx 24rpx;
}

.rules-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.rules-text {
  font-size: 28rpx;
  color: #555555;
}

/* ========== Modal ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  box-sizing: border-box;
}

.modal-content {
  background-color: #ffffff;
  border-radius: 20rpx;
  width: 100%;
  max-width: 640rpx;
  border: 1rpx solid #e8e8e8;
  overflow: hidden;
  box-sizing: border-box;
}

.modal-header {
  padding: 28rpx 28rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-bottom: none;
}

.modal-title {
  font-size: 34rpx;
  color: #666666;
  font-weight: bold;
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 44rpx;
  color: #e64340;
  padding: 0 8rpx;
}

.modal-body {
  padding: 0;
  background-color: #f5f5f5;
}

.card-input-area {
  padding: 40rpx 30rpx;
}

.big-card-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background-color: #ffffff;
  border: none;
  border-radius: 0;
  padding: 0;
  font-size: 40rpx;
  color: #333333;
  letter-spacing: 0;
  box-sizing: border-box;
}

.big-input-placeholder {
  color: #999999;
  font-size: 40rpx;
  letter-spacing: 0;
}

.modal-footer-btns {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
}

.contact-btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 30rpx;
  color: #45b14a;
  text-align: center;
  white-space: nowrap;
}

.contact-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.sep-line {
  width: 2rpx;
  height: 44rpx;
  background-color: #e8e8e8;
  margin: 0 20rpx;
  flex-shrink: 0;
}

.confirm-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #f59e0b;
  text-align: center;
  white-space: nowrap;
}

.activating-btn {
  opacity: 0.7;
}

/* ========== 图片弹窗 ========== */
.image-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-modal-content {
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  animation: modalFadeIn 0.3s ease-out;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.image-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.image-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.image-modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.image-modal-body {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-image {
  width: 480rpx;
  border-radius: 12rpx;
}

.image-modal-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}
