.category-detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.custom-nav {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
}

.nav-placeholder {
  background-color: #fff;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-right: 60rpx;
}

.search-bar-wrap {
  padding: 20rpx 20rpx;
  background-color: #fff;
}

.search-bar {
  background-color: #f5f5f5;
  border-radius: 44rpx;
  padding: 18rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.search-icon {
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-placeholder {
  color: #bbb;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  background-color: #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}

.filter-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
}

.filter-item.active .filter-text {
  color: #f59e0b;
  font-weight: bold;
}

.filter-item.active .filter-arrow {
  color: #f59e0b;
}

.filter-text {
  font-size: 28rpx;
  color: #333;
}

.filter-arrow {
  font-size: 20rpx;
  color: #999;
  transition: transform 0.2s;
}

.filter-arrow.up {
  transform: rotate(180deg);
}

.filter-divider {
  width: 1rpx;
  height: 30rpx;
  background-color: #e0e0e0;
}

.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.dropdown-content {
  position: fixed;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 201;
  max-height: 60vh;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.category-dropdown {
  top: calc({{statusBarHeight}}px + 88rpx + 120rpx + 96rpx);
}

.sub-dropdown {
  top: calc({{statusBarHeight}}px + 88rpx + 120rpx + 96rpx);
}

.dropdown-scroll {
  max-height: 60vh;
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.dropdown-item.selected {
  background-color: #fff9f0;
}

.item-text {
  font-size: 28rpx;
  color: #333;
}

.dropdown-item.selected .item-text {
  color: #f59e0b;
  font-weight: bold;
}

.check-icon {
  font-size: 32rpx;
  color: #f59e0b;
  font-weight: bold;
}

.resource-list-wrap {
  flex: 1;
  padding: 20rpx;
}

.resource-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.resource-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-cover {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cover-text {
  font-size: 56rpx;
}

.vip-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

.hot-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background-color: #ef4444;
  color: #fff;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-info {
  padding: 16rpx;
}

.card-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-views {
  font-size: 22rpx;
  color: #999;
}

.meta-date {
  font-size: 22rpx;
  color: #bbb;
}

.load-more {
  text-align: center;
  padding: 36rpx 0;
  font-size: 26rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
