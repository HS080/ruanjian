.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  padding-bottom: 40rpx;
}

.header {
  text-align: center;
  padding-top: 20rpx;
  margin-bottom: 20rpx;
}
.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}
.subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 6rpx;
}

/* 统计面板 */
.stats-panel {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.stat-box {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 6rpx;
}
.stat-total .stat-num { color: #667eea; }
.stat-unused .stat-num { color: #10b981; }
.stat-used .stat-num { color: #f59e0b; }

/* Tab栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #888;
  transition: all 0.3s;
}
.tab-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

/* 面板 */
.panel {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

/* 表单 */
.form-section { margin-bottom: 25rpx; }
.form-item { margin-bottom: 20rpx; }
.label { display: block; font-size: 27rpx; font-weight: 600; color: #444; margin-bottom: 10rpx; }
.input {
  width: 100%; height: 84rpx; padding: 0 24rpx;
  border: 2rpx solid #e0e0e0; border-radius: 14rpx;
  font-size: 30rpx; box-sizing: border-box;
}
.picker {
  height: 84rpx; line-height: 84rpx; padding: 0 24rpx;
  background: #f8f9fa; border: 2rpx solid #e0e0e0; border-radius: 14rpx;
  font-size: 28rpx; color: #333;
}

/* 按钮 */
.btn-generate {
  width: 100%; height: 92rpx;
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: #fff; border: none; border-radius: 18rpx;
  font-size: 32rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(17,153,142,0.3);
}
.btn-generate[disabled] { background: #ccc; box-shadow: none; }

.btn-secondary {
  width: 100%; height: 80rpx; margin-top: 16rpx;
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  color: #fff; border: none; border-radius: 14rpx;
  font-size: 28rpx; font-weight: 600;
}
.btn-reset {
  width: 100%; height: 76rpx; margin-top: 12rpx;
  background: #f1f5f9; color: #64748b; border: none; border-radius: 14rpx;
  font-size: 26rpx;
}

/* 结果区域 */
.result-section { margin-top: 25rpx; }
.success-banner {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  border-radius: 14rpx; padding: 24rpx;
  display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx;
}
.success-icon { font-size: 44rpx; }
.success-title { display: block; font-size: 30rpx; font-weight: bold; color: #065f46; }
.success-desc { display: block; font-size: 24rpx; color: #047857; margin-top: 4rpx; }

.error-banner {
  background: #fef2f2; border: 2rpx solid #fecaca;
  border-radius: 14rpx; padding: 20rpx;
  display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx;
}
.error-icon { font-size: 34rpx; }
.error-msg { font-size: 24rpx; color: #dc2626; flex: 1; }

/* 卡密迷你列表 */
.cards-mini-list { margin-top: 20rpx; }
.section-title-small { font-size: 25rpx; font-weight: 600; color: #555; margin-bottom: 12rpx; }
.scroll-horizontal { white-space: nowrap; }
.mini-card-inline {
  display: inline-flex; align-items: center; gap: 8rpx;
  background: #f8fafc; border: 2rpx solid #e2e8f0;
  border-radius: 10rpx; padding: 12rpx 16rpx; margin-right: 10rpx; margin-bottom: 10rpx;
}
.mini-key { font-family: monospace; font-size: 24rpx; font-weight: bold; letter-spacing: 1px; }
.mini-copy-btn {
  padding: 4rpx 14rpx; background: #667eea; color: #fff;
  border-radius: 6rpx; font-size: 20rpx;
}

/* 筛选区域 */
.filter-section { margin-bottom: 20rpx; }
.search-box {
  display: flex; align-items: center; background: #fff;
  border: 2rpx solid #e0e0e0; border-radius: 12rpx; padding: 0 20rpx; margin-bottom: 16rpx;
}
.search-icon { font-size: 28rpx; margin-right: 10rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 27rpx; }

.filter-tabs { display: flex; gap: 10rpx; margin-bottom: 12rpx; }
.filter-tab {
  flex: 1; text-align: center; padding: 14rpx 0;
  background: #f1f5f9; border-radius: 10rpx;
  font-size: 24rpx; color: #64748b; font-weight: 500;
}
.filter-tab.active { background: #667eea; color: #fff; }

.btn-refresh {
  width: 100% !important; height: 68rpx !important;
  background: #f1f5f9 !important; color: #64748b !important;
  border: none !important; border-radius: 12rpx !important;
  font-size: 26rpx !important; font-weight: 600 !important;
}

/* 卡密列表 */
.card-list-section {}
.list-header { margin-bottom: 16rpx; }
.list-info { font-size: 24rpx; color: #888; }

.card-detail-row {
  background: #fafafa; border: 2rpx solid #f0f0f0;
  border-radius: 14rpx; padding: 20rpx; margin-bottom: 16rpx;
}
.card-main { margin-bottom: 12rpx; }
.card-top { display: flex; align-items: center; gap: 12rpx; margin-bottom: 14rpx; }
.card-key-text {
  font-family: 'Courier New', monospace; font-size: 30rpx;
  font-weight: bold; letter-spacing: 2rpx; color: #1e293b;
}
.tag {
  padding: 4rpx 14rpx; border-radius: 6rpx;
  font-size: 20rpx; font-weight: 600;
}
.tag-used { background: #fef3c7; color: #92400e; }
.tag-unused { background: #d1fae5; color: #065f46; }

.card-info-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.info-cell {
  width: calc(50% - 4rpx); background: #fff;
  border-radius: 8rpx; padding: 12rpx;
  border: 1rpx solid #f0f0f0;
}
.info-label { display: block; font-size: 20rpx; color: #94a3b8; }
.info-value { display: block; font-size: 23rpx; color: #334155; font-weight: 500; margin-top: 4rpx; }
.user-id { font-family: monospace; font-size: 20rpx; word-break: break-all; }

.card-actions { display: flex; gap: 16rpx; justify-content: flex-end; }
.action-copy {
  padding: 8rpx 24rpx; background: #667eea; color: #fff;
  border-radius: 8rpx; font-size: 23rpx;
}
.action-delete {
  padding: 8rpx 24rpx; background: #ef4444; color: #fff;
  border-radius: 8rpx; font-size: 23rpx;
}

/* 分页 */
.pagination {
  display: flex; align-items: center; justify-content: center;
  gap: 20rpx; margin-top: 24rpx; padding: 16rpx 0;
}
.page-btn {
  padding: 12rpx 28rpx; background: #667eea; color: #fff;
  border-radius: 10rpx; font-size: 24rpx;
}
.page-btn.disabled { background: #ccc; color: #999; }
.page-info { font-size: 26rpx; color: #555; font-weight: 600; }

/* 空状态和加载 */
.empty-state { text-align: center; padding: 60rpx 0; }
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.empty-text { display: block; font-size: 30rpx; color: #888; font-weight: 500; }
.empty-hint { display: block; font-size: 24rpx; color: #aaa; margin-top: 8rpx; }

.loading-state { text-align: center; padding: 40rpx 0; }
.loading-text { font-size: 26rpx; color: #888; }

/* 无权限提示 */
.no-permission {
  text-align: center;
  padding: 100rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-top: 20rpx;
}
.no-perm-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}
.no-perm-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}
.no-perm-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}
.no-perm-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 用户管理样式 */
.user-stats-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.user-list-section {}
.user-detail-row {
  background: #fafafa;
  border: 2rpx solid #f0f0f0;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.user-main { margin-bottom: 12rpx; }
.user-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.user-nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
}
.tag-vip {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
}
.tag-normal {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: #f1f5f9;
  color: #64748b;
}
.user-info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.vip-expire {
  color: #059669 !important;
  font-weight: 600;
}
.user-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.action-view {
  padding: 8rpx 24rpx;
  background: #3b82f6;
  color: #fff;
  border-radius: 8rpx;
  font-size: 23rpx;
}
.action-edit {
  padding: 8rpx 24rpx;
  background: #f59e0b;
  color: #fff;
  border-radius: 8rpx;
  font-size: 23rpx;
}

/* ========== 资源管理样式 ========== */
.res-action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}
.res-action-bar .btn-generate,
.res-action-bar .btn-secondary,
.res-action-bar .btn-refresh {
  font-size: 24rpx !important;
}
.resource-stats-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.res-row {
  border-left-color: #6366f1 !important;
}
.res-title-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}
.price-val {
  color: #ef4444 !important;
  font-weight: 600;
}
.link-val {
  color: #3b82f6 !important;
  font-size: 22rpx;
}
.tag-free {
  background: #22c55e;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

/* 资源弹窗样式 */
.resource-modal {
  max-height: 85vh !important;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}
.modal-close {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 8rpx;
}
.modal-body {
  padding: 28rpx 32rpx;
  max-height: 55vh;
}
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}
.btn-cancel {
  flex: 1;
  padding: 20rpx;
  background: #f3f4f6;
  color: #6b7280;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}
.btn-confirm {
  flex: 1.5;
  padding: 20rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
}
.form-row {
  display: flex;
  gap: 20rpx;
}
.form-item.half {
  flex: 1;
}
.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 批量导入样式 */
.batch-modal {
  width: 90% !important;
  max-width: 650rpx !important;
}
.batch-tips {
  background: #fef3c7;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 8rpx;
}
.tip-text {
  display: block;
  font-size: 24rpx;
  color: #a16207;
  line-height: 1.5;
}
.json-textarea {
  width: 100%;
  min-height: 300rpx;
  max-height: 400rpx;
  padding: 20rpx;
  background: #1f2937;
  color: #10b981;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-family: monospace;
  box-sizing: border-box;
  line-height: 1.5;
}
.batch-preview {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #dcfce7;
  border-radius: 8rpx;
}
.preview-text {
  font-size: 24rpx;
  color: #166534;
}
